NEXT_PUBLIC_SUPABASE_URL=https://kdbbrxqxqewbjoozmfhq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key — needed by /api/cron/* and admin-only server actions.
# Find under Supabase → Project Settings → API → service_role.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email). https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=GymFlow <hello@gymflow.ng>
EMAIL_REPLY_TO=hello@gymflow.ng

# Termii (WhatsApp / SMS for Nigeria). https://accounts.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=GymFlow

# Shared secret Vercel Cron uses to call /api/cron/*. Generate with: openssl rand -base64 32
CRON_SECRET=

# Localhost / dev: which gym slug to rewrite to. Defaults to gf-test-gym.
LOCAL_DEFAULT_GYM_SLUG=gf-test-gym

# Web Push (VAPID). OPTIONAL — push degrades to a no-op when unset, so the
# app runs fine without these. Generate a keypair with:
#   npx web-push generate-vapid-keys
# The public key is exposed to the browser (NEXT_PUBLIC_); the private key is
# server-only. VAPID_SUBJECT is a mailto: or https: contact URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gymflow.ng
