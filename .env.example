# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # or legacy anon JWT
SUPABASE_SERVICE_ROLE_KEY=                          # server-only; Paystack/cron/admin writes

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://gymflow.ng
# Root domain for per-gym subdomains (<slug>.<root>). Defaults to the host in
# NEXT_PUBLIC_SITE_URL, then gymflow.ng. Set explicitly for custom/staging domains.
# Requires a wildcard domain (*.<root>) on Vercel + wildcard DNS to actually resolve.
NEXT_PUBLIC_ROOT_DOMAIN=gymflow.ng

# ── Paystack (Naira subscriptions) ──
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Platform (gym → GymFlow) SaaS billing via Paystack Subscriptions.
# Two tiers × three billing cycles = six NGN Plans, created once in the Paystack
# dashboard. Each plan's INTERVAL must match its cycle and its AMOUNT must match
# lib/platform-plans.ts — Paystack charges the plan's own amount, so a mismatch
# means gyms are billed something other than what the pricing page advertises.
#   Starter  monthly   ₦13,999   (interval: monthly)
#   Starter  quarterly ₦37,999   (interval: quarterly)
#   Starter  annual    ₦121,999  (interval: annually)
#   Growth   monthly   ₦37,999   (interval: monthly)
#   Growth   quarterly ₦102,999  (interval: quarterly)
#   Growth   annual    ₦329,999  (interval: annually)
# Without them, gym billing checkout returns a clear "not set up" error for the
# affected cycle (the rest of the app is unaffected).
#
# The two monthly vars are the ORIGINAL Starter/Growth plans — same codes, same
# ₦13,999 / ₦37,999 amounts — so existing monthly subscribers keep billing
# uninterrupted and need no migration.
PAYSTACK_PLAN_STARTER=PLN_xxx
PAYSTACK_PLAN_GROWTH=PLN_xxx
PAYSTACK_PLAN_STARTER_QUARTERLY=PLN_xxx
PAYSTACK_PLAN_STARTER_ANNUAL=PLN_xxx
PAYSTACK_PLAN_GROWTH_QUARTERLY=PLN_xxx
PAYSTACK_PLAN_GROWTH_ANNUAL=PLN_xxx

# Retired Scale plan (₦119,999/mo). Not sellable — Scale folded into Growth —
# but KEEP THIS SET while any gym still bills on it: its recurring
# charge.success arrives with this plan code, and lib/platform-charge.ts needs
# the code to recognise the charge and extend the gym. Safe to delete once no
# gym is on a Scale subscription.
PAYSTACK_PLAN_SCALE=PLN_xxx

# ── Email (Resend) ──
# Transactional email: renewal reminders, payment receipts, auto-renew dunning,
# payout-account change alerts. Without a key those are silently skipped
# (fail-open) — no feature breaks, messages just aren't sent. RESEND_FROM must
# be a sender on a domain verified in Resend; defaults to
# noreply@<NEXT_PUBLIC_ROOT_DOMAIN>.
#
# LOAD-BEARING since two-factor sign-in: staff second-factor codes FAIL CLOSED.
# With no key (or a suppressed address) the code can't be delivered, and the
# sign-in is refused rather than waved through — so on any deploy where gyms
# have two-factor enabled, this key is required for staff to reach their
# console at all. A gym can turn the requirement off in Settings → Security.
RESEND_API_KEY=
RESEND_FROM=GymFlow <noreply@gymflow.ng>

# Domain that GYM-BRANDED mail is sent from. Each gym gets its own local part
# and display name on this domain — "Iron Republic <iron-republic@gymflow.ng>".
# Defaults to NEXT_PUBLIC_ROOT_DOMAIN. Point it at a dedicated *verified*
# subdomain (e.g. gyms.gymflow.ng) to isolate tenant sending reputation from
# platform mail like password resets. Must be verified in Resend to deliver.
EMAIL_TENANT_DOMAIN=

# Where member "reply/contact" links go when GymFlow is the sender (support,
# auth). Defaults to support@<NEXT_PUBLIC_ROOT_DOMAIN>.
EMAIL_SUPPORT_ADDRESS=

# Who receives GymFlow's own operational alerts — contact-form submissions and
# payment-underpayment notices. Comma-separated. Unset = those alerts are
# skipped (fail-open); no feature breaks.
PLATFORM_ALERT_EMAILS=

# Supabase "Send Email" auth hook secret (Supabase → Authentication → Emails →
# Hooks → Send email → generate). When set, Supabase stops sending its default
# auth mail and POSTs to /api/auth/email-hook, which renders branded confirm /
# recovery / invite / magic-link / email-change / reauth mail via Resend. Unset
# = the hook returns 501 and Supabase's built-in templates are used instead.
# Paste it exactly as Supabase shows it — "v1,whsec_..." prefix included; the
# verifier strips the prefixes itself. Hand-stripping risks a silently wrong key
# (base64 ignores stray characters), which 401s every auth email.
SUPABASE_AUTH_HOOK_SECRET=

# Resend delivery webhook secret (Resend → Webhooks → add endpoint pointing at
# /api/resend/webhook → copy the signing secret, "whsec_..."). Feeds the
# email_events ledger and auto-suppresses hard bounces / complaints so a dead
# address can't erode the shared sending-domain reputation. Unset = the webhook
# returns 501.
RESEND_WEBHOOK_SECRET=

# ── WhatsApp / SMS (Termii) ──
# FALLBACK reminder delivery. The primary WhatsApp path is the Cloud API block
# below; Termii is used when a member has no WhatsApp contact row (they have
# never messaged the business number), and as a backstop if a Cloud API send
# fails. Fail-open like email: without a key those sends are skipped and members
# still get the in-app and email reminder. TERMII_SENDER_ID must be a sender ID
# approved in the Termii dashboard; defaults to "GymFlow".
TERMII_API_KEY=
TERMII_SENDER_ID=GymFlow

# ── WhatsApp Cloud API (Meta) ──
# The member-facing WhatsApp channel: sign-up/sign-in, check-in/out, remaining
# days, package purchase and renewal reminders. One WABA and one business number
# front EVERY gym on the platform; per-gym behaviour (including the customer
# service number members are given) lives in the gym_whatsapp_settings table,
# not here.
#
# Without WHATSAPP_ACCESS_TOKEN every send is skipped and the webhook still
# accepts and logs inbound messages, so a missing key degrades the channel
# rather than breaking the app.
WHATSAPP_ACCESS_TOKEN=                  # system-user token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=               # e.g. 1245745388626014
META_WABA_ID=                           # e.g. 1517129227120669
WHATSAPP_GRAPH_VERSION=v25.0            # optional; defaults to v25.0

# Inbound webhook (Meta → /api/whatsapp/webhook).
# META_APP_SECRET is a SECURITY BOUNDARY: it verifies X-Hub-Signature-256 so
# only Meta can drive the conversation. The verifier fails OPEN when unset (to
# match how the rest of the codebase treats unconfigured integrations), so it
# must be set in production or anyone who finds the URL can impersonate any
# member's WhatsApp number.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=          # any random string; also pasted into Meta's webhook config
META_APP_SECRET=

# The number members message, in international digits (no +). Used to build the
# printable WhatsApp door-QR on /admin/staff-checkin.
WHATSAPP_BUSINESS_NUMBER=2349169582776

# Signs the gym token inside the door QR so a guessed message can't check
# someone into an arbitrary gym. Falls back to SECRETS_ENCRYPTION_KEY when unset.
# Changing it invalidates every printed QR — reprint before rotating.
WHATSAPP_QR_SECRET=

# ── WhatsApp Flows (sign-up / sign-in form) ──
# Flows are end-to-end encrypted: the member's password never appears in the
# chat transcript and never reaches Meta in the clear. That requires an RSA
# keypair — private key here, public key uploaded to Meta.
#
#   node scripts/whatsapp-setup.mjs keys        generate the pair
#   node scripts/whatsapp-setup.mjs upload-key  register the public half
#   node scripts/whatsapp-setup.mjs flow        upload + publish the Flow JSON
#
# Store the PEM with literal \n escapes (Vercel env vars cannot hold newlines);
# the loader unescapes them. Meta requires the private key to be passphrase
# protected. Without these the Flow endpoint returns 501 and the conversation
# tells members to use the app instead — nothing else breaks.
WHATSAPP_FLOW_PRIVATE_KEY=
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
WHATSAPP_FLOW_ID=                       # printed by `whatsapp-setup.mjs flow`
WHATSAPP_FLOW_ENDPOINT_URI=https://gymflow.ng/api/whatsapp/flow

# ── Secret encryption ──
# AES-256-GCM key for the AI provider API keys stored in ai_providers and
# gym_ai_settings. 32 bytes, base64 or hex: `openssl rand -base64 32`.
# Encryption REFUSES rather than silently storing plaintext when unset, so the
# admin UI disables the "paste an API key" field and says why.
# Rotating this makes every stored provider key unreadable — they must be
# re-entered, so treat it as permanent.
SECRETS_ENCRYPTION_KEY=

# ── Cron ──
CRON_SECRET=                                        # authorizes /api/cron (openssl rand -hex 32); Vercel Cron sends it automatically

# ── Error monitoring (Sentry) ──
# Optional. When set, uncaught server errors are forwarded to Sentry (in
# addition to the client_errors table) via lib/sentry.ts. Leave blank to
# disable — the forwarder is a no-op without it and adds no dependencies.
# Format: https://<publicKey>@<host>/<projectId>
SENTRY_DSN=
