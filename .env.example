# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # or legacy anon JWT
SUPABASE_SERVICE_ROLE_KEY=                          # server-only; Paystack/cron/admin writes

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://gymflow.ng
# Root domain for per-gym subdomains (<slug>.<root>). Defaults to the host in
# NEXT_PUBLIC_SITE_URL, then gymflow.ng. Set explicitly for custom/staging domains.
# Requires a wildcard domain (*.<root>) on Vercel + wildcard DNS to actually resolve.
NEXT_PUBLIC_ROOT_DOMAIN=gymflow.ng

# ── Paystack (Naira subscriptions) ──
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Platform (gym → GymFlow) SaaS billing via Paystack Subscriptions.
# Create three monthly NGN Plans in the Paystack dashboard (₦13,999 / ₦37,999 /
# ₦119,999) and paste their plan codes here. Without them, gym billing checkout
# returns a clear "not set up" error (the rest of the app is unaffected).
PAYSTACK_PLAN_STARTER=PLN_xxx
PAYSTACK_PLAN_GROWTH=PLN_xxx
PAYSTACK_PLAN_SCALE=PLN_xxx

# ── Email (Resend) ──
# Transactional email: renewal reminders, payment receipts, auto-renew dunning,
# payout-account change alerts. Without a key, email is silently skipped
# (fail-open) — no feature breaks, messages just aren't sent. RESEND_FROM must
# be a sender on a domain verified in Resend; defaults to
# noreply@<NEXT_PUBLIC_ROOT_DOMAIN>.
RESEND_API_KEY=
RESEND_FROM=GymFlow <noreply@gymflow.ng>

# Domain that GYM-BRANDED mail is sent from. Each gym gets its own local part
# and display name on this domain — "Iron Republic <iron-republic@gymflow.ng>".
# Defaults to NEXT_PUBLIC_ROOT_DOMAIN. Point it at a dedicated *verified*
# subdomain (e.g. gyms.gymflow.ng) to isolate tenant sending reputation from
# platform mail like password resets. Must be verified in Resend to deliver.
EMAIL_TENANT_DOMAIN=

# Where member "reply/contact" links go when GymFlow is the sender (support,
# auth). Defaults to support@<NEXT_PUBLIC_ROOT_DOMAIN>.
EMAIL_SUPPORT_ADDRESS=

# Who receives GymFlow's own operational alerts — contact-form submissions and
# payment-underpayment notices. Comma-separated. Unset = those alerts are
# skipped (fail-open); no feature breaks.
PLATFORM_ALERT_EMAILS=

# Supabase "Send Email" auth hook secret (Supabase → Authentication → Emails →
# Hooks → Send email → generate). When set, Supabase stops sending its default
# auth mail and POSTs to /api/auth/email-hook, which renders branded confirm /
# recovery / invite / magic-link / email-change / reauth mail via Resend. Unset
# = the hook returns 501 and Supabase's built-in templates are used instead.
SUPABASE_AUTH_HOOK_SECRET=

# Resend delivery webhook secret (Resend → Webhooks → add endpoint pointing at
# /api/resend/webhook → copy the signing secret, "whsec_..."). Feeds the
# email_events ledger and auto-suppresses hard bounces / complaints so a dead
# address can't erode the shared sending-domain reputation. Unset = the webhook
# returns 501.
RESEND_WEBHOOK_SECRET=

# ── WhatsApp / SMS (Termii) ──
# Renewal-reminder delivery over WhatsApp for Growth+ gyms. Fail-open like
# email: without a key, WhatsApp sends are skipped and members still get the
# in-app (and email) reminder. TERMII_SENDER_ID must be a sender ID approved
# in the Termii dashboard; defaults to "GymFlow".
TERMII_API_KEY=
TERMII_SENDER_ID=GymFlow

# ── Cron ──
CRON_SECRET=                                        # authorizes /api/cron (openssl rand -hex 32); Vercel Cron sends it automatically

# ── Error monitoring (Sentry) ──
# Optional. When set, uncaught server errors are forwarded to Sentry (in
# addition to the client_errors table) via lib/sentry.ts. Leave blank to
# disable — the forwarder is a no-op without it and adds no dependencies.
# Format: https://<publicKey>@<host>/<projectId>
SENTRY_DSN=
