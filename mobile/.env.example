# Where the GymFlow Next.js app lives. The app talks to nothing else — no
# Supabase keys ship in the binary, because every query goes through
# /api/app/* with the member's own token.
#
# Copy to .env.local for development. For real builds set it in eas.json's
# build profiles instead, so a device build can't pick up a laptop's value.
#
# Pointing at a dev server from a physical Android device needs a LAN address
# or a tunnel — "localhost" on the phone is the phone.
EXPO_PUBLIC_API_URL=https://gymflow.ng
