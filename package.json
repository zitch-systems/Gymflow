{
  "name": "gymflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dry": "node scripts/migrate.mjs --dry-run",
    "db:baseline": "node scripts/migrate.mjs --baseline"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.471.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "pg": "^8.13.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9",
    "vercel": "62.1.0"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "nanoid@<3.3.18": "3.3.18",
      "browserslist@<=4.28.6": "4.28.7",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.26"
    }
  }
}
