{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // DOM alongside ES2022 because tests import the server modules they
    // exercise, and those reach for web types the app's own tsconfig has
    // (fetch's RequestInit in lib/paystack.ts and lib/whatsapp/cloud-api.ts).
    // Nothing here runs in a browser; this only stops the test program from
    // type-checking app code against a narrower lib than the app build does.
    "lib": ["ES2022", "DOM"],
    "jsx": "preserve",
    "types": ["node", "vitest/globals"],
    "plugins": []
  },
  "include": ["test/**/*.ts", "vitest.config.ts"],
  "exclude": []
}
