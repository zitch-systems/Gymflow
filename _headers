# GymFlow — Cloudflare Pages / Netlify headers
# Both platforms support this format.

# Static assets: cache aggressively (1 year, immutable)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML: never cache (always revalidate so users get latest)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

# Manifest: short cache so PWA updates pick up
/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Service worker: never cache (so SW updates are picked up immediately)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Root and pretty URLs (HTML rewrites)
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
