{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 8 * * *" },
    { "path": "/api/cron/backups", "schedule": "20 * * * *" },
    { "path": "/api/cron/reconcile", "schedule": "7,22,37,52 * * * *" },
    { "path": "/api/cron/webhook-recovery", "schedule": "*/5 * * * *" }
  ]
}
